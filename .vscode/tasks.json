{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile File",
            "type": "cppbuild",
            "command": "cmake",
            "args": [
                "--build",
                "${fileDirname}/build",
                "--target",
                "${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}