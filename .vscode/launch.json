{
	"version": "0.2.0",
	"configurations":
	[
		{
			"name": "GDB Launcher",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}\\build\\install\\${fileBasenameNoExtension}.exe",
			"args": [
				"${workspaceFolder}\\ico\\*"
			],
			"stopAtEntry": false,
			"cwd": "${workspaceRoot}",
			"environment": [],
			"externalConsole": true,
			"MIMode": "gdb",
			"miDebuggerPath": "gdb",
			"preLaunchTask": "Compile File",
			"setupCommands": 
			[
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		}
	]
}