{
	"version": "0.2.0",
	"configurations":
	[
		{
			"name": "GDB Launcher",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}\\build\\${fileDirnameBasename}\\${fileDirnameBasename}.exe",
			"args": [
				"..\\Templates\\us-1.udp.ovpn",
				"..\\Templates\\uk-2.udp.ovpn",
				"..\\Templates\\ca-3.tcp.ovpn",
				"..\\Templates\\jp-4.tcp.ovpn"
			],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}\\build\\${fileDirnameBasename}",
			"environment": [],
			"externalConsole": true,
			"MIMode": "gdb",
			"miDebuggerPath": "gdb",
			"preLaunchTask": "Compile File",
			"setupCommands": 
			[
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		}
	]
}