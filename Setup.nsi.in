!define NAME "OpenVPN Config Manager"
!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${NAME}"
!define DIRMENU_KEY "Directory\shell\OpenVPN Config Manager"
!define CMDMENU_KEY "SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell"

!addincludedir "@CMAKE_SOURCE_DIR@"
!include "LogicLib.nsh"
!include "MUI2.nsh"
!include "lib.nsh"

Name "${NAME}"
OutFile "OpenVPNConfigManagerSetup-@PROJECT_VERSION@.exe"
InstallDir "$PROGRAMFILES32\${NAME}" 
RequestExecutionLevel "admin"

!define MUI_ICON "@CMAKE_CURRENT_SOURCE_DIR@/resource/InstallerLight.ico"
!define MUI_UNICON "@CMAKE_CURRENT_SOURCE_DIR@/resource/UninstallerLight.ico"
; Installer Page
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "@CMAKE_CURRENT_SOURCE_DIR@/LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
ShowInstDetails show
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_NOAUTOCLOSE
!insertmacro MUI_PAGE_FINISH
; Uninstaller Page
!insertmacro MUI_UNPAGE_WELCOME
!define MUI_UNCONFIRMPAGE_TEXT_TOP "This wizard will completely uninstall ${NAME} and all of its components from this computer."
!define MUI_UNCONFIRMPAGE_TEXT_LOCATION "Uninstall Directory"
!insertmacro MUI_UNPAGE_CONFIRM
ShowUnInstDetails show
!insertmacro MUI_UNPAGE_INSTFILES
!define MUI_UNFINISHPAGE_NOAUTOCLOSE
!define MUI_FINISHPAGE_LINK "Propose issues on Github"
!define MUI_FINISHPAGE_LINK_LOCATION "https://github.com/Narezzurri/OpenVPN-Config-Manager/issues"
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "English"

Section "install"
	; Program files
	SetOutPath "$INSTDIR"
	File "Checker\Checker.exe"
	File "Authenticator\Auth.exe"
	File "Renamer\Renamer.exe"
	File "stdlib\stdlib.dll"
	File "inih\inih.dll"
	File "@CMAKE_CURRENT_SOURCE_DIR@\LICENSE"
	File "@CMAKE_CURRENT_SOURCE_DIR@\NOTICE"
	WriteUninstaller "Uninstall.exe"
	; Template files
	SetOutPath "$INSTDIR\Templates"
	File "@CMAKE_CURRENT_SOURCE_DIR@\Templates\Template1.ovpn"
	File "@CMAKE_CURRENT_SOURCE_DIR@\Templates\Template2.ovpn"
	File "@CMAKE_CURRENT_SOURCE_DIR@\Templates\Template3.ovpn"
	File "@CMAKE_CURRENT_SOURCE_DIR@\Templates\Template4.ovpn"
	; Start Menu
	CreateDirectory "$SMPROGRAMS\${NAME}"
	CreateShortCut "$SMPROGRAMS\${NAME}\OpenVPN Config Checker.lnk" "$INSTDIR\Checker.exe"
	CreateShortCut "$SMPROGRAMS\${NAME}\OpenVPN Config Authenticator.lnk" "$INSTDIR\Auth.exe"
	CreateShortCut "$SMPROGRAMS\${NAME}\OpenVPN Config Renamer.lnk" "$INSTDIR\Renamer.exe"
	CreateShortCut "$SMPROGRAMS\${NAME}\Uninstall.lnk" "$INSTDIR\Uninstall.exe"
	; Add to PATH
	Push "$INSTDIR"
	Call AddToPath
	; Add to right-click menu for directories
	SetRegView 64
	WriteRegStr "HKCR" "${DIRMENU_KEY}" "MUIVerb" "OpenVPN Config Manager"
	WriteRegStr "HKCR" "${DIRMENU_KEY}" "SubCommands" "@APPLIST@"
	!macro Register APP APP_NAME
		WriteRegStr "HKLM" "${CMDMENU_KEY}\OCM.${APP}" "" "${APP_NAME}"
		WriteRegStr "HKLM" "${CMDMENU_KEY}\OCM.${APP}" "Icon" "$INSTDIR\${APP}.exe"
		WriteRegStr "HKLM" "${CMDMENU_KEY}\OCM.${APP}\command" "" "$INSTDIR\${APP}.exe %V\*.ovpn"
	!macroend
	!insertmacro Register "Checker" "Checker"
	!insertmacro Register "Auth" "Authenticator"
	!insertmacro Register "Renamer" "Renamer"
	; Uninstall information
	SetRegView 64
	WriteRegStr "HKLM" "${UNINST_KEY}" "DisplayName" "${NAME}"
	WriteRegStr "HKLM" "${UNINST_KEY}" "UninstallString" "$INSTDIR\Uninstall.exe"
	WriteRegStr "HKLM" "${UNINST_KEY}" "DisplayVersion" "@PROJECT_VERSION@"
	WriteRegStr "HKLM" "${UNINST_KEY}" "Publisher" "Narezzurri"
	WriteRegStr "HKLM" "${UNINST_KEY}" "HelpLink" "https://github.com/Narezzurri/OpenVPN-Config-Manager"
SectionEnd

Section "uninstall"
	; Program files & Template files
	RMDir /r "$INSTDIR"
	; Start Menu
	RMDir /r "$SMPROGRAMS\${NAME}"
	; Remove from PATH
	Push "$INSTDIR"
	Call un.RemoveFromPath
	; Remove from right-click menu for directories
	SetRegView 64
	DeleteRegKey HKCR "${DIRMENU_KEY}"
	DeleteRegKey HKLM "${CMDMENU_KEY}\OCM.Checker"
	DeleteRegKey HKLM "${CMDMENU_KEY}\OCM.Auth"
	DeleteRegKey HKLM "${CMDMENU_KEY}\OCM.Renamer"
	; Uninstall information
	SetRegView 64
	DeleteRegKey "HKLM" "${UNINST_KEY}"
SectionEnd
