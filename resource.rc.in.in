#include	"resource.h"
#include	<windows.h>

LIGHTICON	ICON	"@CMAKE_CURRENT_SOURCE_DIR@/resource/@AT@NAME@AT@Light.ico"
DARKICON	ICON	"@CMAKE_CURRENT_SOURCE_DIR@/resource/@AT@NAME@AT@Dark.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION		@AT@PROJECT_VERSION_MAJOR@AT@,@AT@PROJECT_VERSION_MINOR@AT@,@AT@PROJECT_VERSION_PATCH@AT@,0
PRODUCTVERSION	@PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS			VOS_NT_WINDOWS32
FILETYPE		VFT_APP
{
	BLOCK "StringFileInfo"
	{
		BLOCK "000004b0"
		{
			VALUE	"Comments",			""
			VALUE	"CompanyName",		"Narezzurri"
			VALUE	"FileDescription",	"OpenVPN Config @AT@DIR@AT@"
			VALUE	"FileVersion",		"@AT@PROJECT_VERSION_MAJOR@AT@.@AT@PROJECT_VERSION_MINOR@AT@.@AT@PROJECT_VERSION_PATCH@AT@"
			VALUE	"InternalName",		"@AT@PROJECT_NAME@AT@"
			VALUE	"LegalCopyright",	"Copyright (C) 2026 Narezzurri. All rights reserved."
			VALUE	"LegalTrademarks",	""
			VALUE	"OriginalFilename",	"@AT@NAME@AT@"
			VALUE	"ProductName",		"OpenVPN Config Manager"
			VALUE	"ProductVersion",	"@AT@PROJECT_VERSION@AT@"
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE	"Translation",0x0000,0x04b0					// Language Neutral
	}
}
